# Copy this file to .env before running Prisma commands.
# SQLite database in the project root (paths are relative to prisma/schema.prisma)
DATABASE_URL="file:../dev.db"

# Session cookie encryption secret - MUST be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL for server-side redirects (recommended behind reverse proxies).
# Example: APP_ORIGIN="https://famstagram.example.com"
APP_ORIGIN=""

# Passkey / WebAuthn configuration for sign-in with Face ID / Touch ID / Windows Hello.
# In local development this defaults to http://localhost:3000 and rpID=localhost.
WEBAUTHN_ORIGIN="http://localhost:3000"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Famstagram"

# Media storage: "local" (default) or "s3" (S3-compatible, e.g. MinIO)
STORAGE_DRIVER="local"

# Local driver: folder where uploaded media is stored
UPLOAD_DIR="./uploads"

# S3 / MinIO driver (only used when STORAGE_DRIVER="s3")
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="famstagram"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"

# Seed script admin credentials (used by: npm run db:seed)
# ADMIN_USERNAME="admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD="change-me-admin"

# Browser push notifications. Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"  
PUSH_DEBUG="false"
