generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             String   @default("member") // "admin" | "member"
  createdAt        DateTime @default(now())
  avatarKey        String?
  avatarMimeType   String?

  posts            Post[]
  likes            Like[]
  comments         Comment[]
  invitesCreated   Invite[]     @relation("InviteCreatedBy")
  inviteUsed       Invite?      @relation("InviteUsedBy")
  sharesSent       SharedPost[] @relation("ShareFrom")
  sharesReceived   SharedPost[] @relation("ShareTo")
  notifications    Notification[] @relation("NotificationUser")
  notificationsSent Notification[] @relation("NotificationActor")
  pushSubscriptions PushSubscription[]
  notificationMutes NotificationMute[] @relation("MuteOwner")
  mutedByOthers    NotificationMute[] @relation("MutedByOthers")
  passkeys         WebAuthnCredential[]
  feedMemberships  FeedMembership[]
}

model Feed {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  memberships   FeedMembership[]
  posts         Post[]
  invites       Invite[]
  notifications Notification[]
}

model FeedMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedId    String
  feed      Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  role      String   @default("member") // "manager" | "member"
  createdAt DateTime @default(now())

  @@unique([userId, feedId])
  @@index([feedId])
  @@index([userId])
}

model WebAuthnCredential {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String  @unique
  publicKey   String
  counter     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  token       String    @unique
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id])
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  feedId      String
  feed        Feed      @relation(fields: [feedId], references: [id])

  @@index([feedId])
}

model Post {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  caption      String   @default("")
  createdAt    DateTime @default(now())
  feedId       String
  feed         Feed     @relation(fields: [feedId], references: [id])
  latitude     Float?
  longitude    Float?
  locationName String?

  media    Media[]
  likes    Like[]
  comments Comment[]
  shares   SharedPost[]
  notifications Notification[]

  @@index([feedId, createdAt])
}

model Media {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  key      String // storage key (filename / S3 object key)
  mimeType String
  order    Int    @default(0)

  @@index([postId])
}

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())
  notifications Notification[]

  @@index([postId])
}

model SharedPost {
  id         String    @id @default(cuid())
  postId     String
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User      @relation("ShareFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User      @relation("ShareTo", fields: [toUserId], references: [id])
  message    String    @default("")
  createdAt  DateTime  @default(now())
  readAt     DateTime?

  @@index([toUserId, createdAt])
}

// Push identity reuses this recipient-scoped row; no additional event table or migration is required.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User      @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  feedId     String
  feed       Feed     @relation(fields: [feedId], references: [id])
  // Stable event identity used to make notification creation and push retries idempotent.
  deliveryKey String? @unique

  @@unique([userId, commentId, type])
  @@index([commentId])
  @@index([userId, createdAt])
  @@index([feedId])
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  userAgent      String?
  p256dh         String
  auth           String
  expirationTime DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// A row means `user` has opted out of "new post" notifications from `mutedUser`.
// Mentions always notify regardless of a mute.
model NotificationMute {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("MuteOwner", fields: [userId], references: [id], onDelete: Cascade)
  mutedUserId String
  mutedUser   User     @relation("MutedByOthers", fields: [mutedUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}
