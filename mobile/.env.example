EXPO_PUBLIC_API_URL=https://www.famstagram.co.uk
# Optional for EAS cloud builds only; NOT required for direct FCM or maps.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Android client config downloaded from Firebase for uk.co.famstagram.nativeapp.
# Local path (e.g. ./google-services.json) or EAS file-environment variable.
# NEVER use a service-account JSON here.
GOOGLE_SERVICES_JSON=./google-services.json
