EXPO_PUBLIC_API_URL=https://www.famstagram.co.uk
# Required for the native Google map on Android. Restrict by package + signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=
# Set after creating/linking the Expo EAS project and configuring Android FCM v1.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Local path or EAS file-environment variable; never a server service-account key.
GOOGLE_SERVICES_JSON=
